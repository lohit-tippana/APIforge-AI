# ── Database ─────────────────────────────────────────────
# Local dev (MySQL 8 running on this machine):
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/apiforge"
# Production (Postgres via docker-compose): see README "Database" section.

# ── API server ───────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=604800      # seconds (7 days)

# ── Redis (optional — in-memory cache used when unset) ────
# REDIS_URL=redis://localhost:6379

# ── AI provider ──────────────────────────────────────────
# Provider abstraction: "openai" (any OpenAI-compatible API)
# or "local" (built-in heuristic engine, works offline).
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Web ──────────────────────────────────────────────────
# Browser talks to /api on the Next.js server which proxies to the API.
NEXT_PUBLIC_APP_NAME=APIForge AI
